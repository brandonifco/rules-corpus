<?xml version="1.0" encoding="utf-8"?>
<!--
  Without this file, restore uses whatever NuGet sources happen to be configured on the
  machine or CI image doing the restoring. That is largely mitigated by
  packages.lock.json plus the locked-mode restore in scripts/validate.sh: a source
  substituting a different build for a pinned version/hash would still be caught. But
  "largely mitigated by the lock file" is a different guarantee than "restore only ever
  talks to nuget.org", and the latter is cheap to have on top.

  clear discards any machine- or CI-image-level sources (e.g. a stray internal feed in a
  global NuGet.Config) before adding the one source this repository restores from.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    Central Package Management (Directory.Packages.props) otherwise emits NU1507 once more
    than one source is configured, because it can no longer assume which source resolves
    which package. There is only one source here, but the mapping also documents intent
    and keeps restore deterministic if a second source is ever added.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
